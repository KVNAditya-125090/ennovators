# ==========================================
# Git Ignore Configuration for AuraCommerce 360
# ==========================================

# Node & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite & Frontend Build Assets
firebase_hosting/dist/
firebase_hosting/dist-ssr/
firebase_hosting/.vite/
*.local

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
cloud_run/venv/
cloud_run/.venv/
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# Environment Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs & OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
*.userossc

# Firebase & Deployment Cache
.firebase/
firebase-debug.log*
firestore-debug.log*

